rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() {
      return request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.catalogEditor == true);
    }
    match /books/{bookId} {
      allow get, list: if editor() || resource.data.published == true;
      allow create, update, delete: if editor();
    }
    match /book_chapters/{chapterId} {
      allow get, list: if editor() ||
        (resource.data.book_id is string &&
         exists(/databases/$(database)/documents/books/$(resource.data.book_id)) &&
         get(/databases/$(database)/documents/books/$(resource.data.book_id)).data.published == true);
      allow create, update, delete: if editor();
    }
    match /book_requests/{requestId} {
      function owner() {
        return request.auth != null && resource.data.requesterUid == request.auth.uid;
      }
      allow get, list: if editor() || owner();
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'title','author','edition','publicationDate','price','isbn','details',
          'requesterUid','requesterEmail','coverPath','coverUrl','status',
          'reason','adminMessage','createdAt'
        ]) &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 3000 &&
        request.resource.data.coverPath.matches('book-request-covers/' + request.auth.uid + '/.*') &&
        request.resource.data.coverUrl is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason == '' &&
        request.resource.data.adminMessage == '' &&
        request.resource.data.createdAt == request.time;
      allow update: if editor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reason','adminMessage','reviewedBy','reviewedAt'
        ]) &&
        request.resource.data.status in ['pending','validated','unresolved'] &&
        request.resource.data.reason in ['','missing_details','pdf_unavailable','other'] &&
        request.resource.data.adminMessage is string &&
        request.resource.data.adminMessage.size() <= 3000 &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /entitlements/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
// IMPORTANT : publier manuellement ces règles dans Firebase Console.
// Ce fichier GitHub n'est pas déployé automatiquement.
