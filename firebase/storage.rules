rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function requestManager() {
      return request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.catalogEditor == true) &&
        request.auth.token.email in ['quentinmorel1912@gmail.com', 'juliepotier2006@gmail.com'];
    }
    match /book-request-pdfs/{uid}/{filename} {
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        filename.matches('[A-Za-z0-9_-]+\\.pdf') &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow read: if request.auth != null &&
        (request.auth.uid == uid || requestManager());
      allow update, delete: if false;
    }
    match /book-request-covers/{uid}/{filename} {
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        resource == null &&
        request.resource.size <= 3 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         request.auth.token.admin == true ||
         request.auth.token.catalogEditor == true);
    }
  }
}
// IMPORTANT : publier manuellement dans Firebase Storage > Rules.
// Ces règles ne couvrent que les couvertures proposées ; fusionner avec les autres règles existantes.
