rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() {
      return request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.catalogEditor == true);
    }
    match /books/{bookId} {
      allow get, list: if editor() || resource.data.published == true;
      allow create, update, delete: if editor();
    }
    match /book_chapters/{chapterId} {
      allow get, list: if editor() ||
        (resource.data.book_id is string &&
         exists(/databases/$(database)/documents/books/$(resource.data.book_id)) &&
         get(/databases/$(database)/documents/books/$(resource.data.book_id)).data.published == true);
      allow create, update, delete: if editor();
    }
    match /entitlements/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
// IMPORTANT : publier manuellement ces règles dans Firebase Console.
// Ce fichier GitHub n'est pas déployé automatiquement.
